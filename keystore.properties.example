# Copy to keystore.properties (git-ignored) to sign release builds. Or set SAFAR_KEYSTORE_FILE,
# SAFAR_KEYSTORE_PASSWORD, SAFAR_KEY_ALIAS and SAFAR_KEY_PASSWORD. Keep the keystore outside the repo and back it
# up: an update must be signed with the same key, or Android refuses to install it over the old app.
storeFile=/absolute/path/to/safar-release.jks
storePassword=change-me
keyAlias=safar
keyPassword=change-me
