<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup. The rider turns it on or off in system Settings > Backup; Safar only opts in.
  Backed up: rides, fuel, service, places and the parked spot (Room safar.db with its journal files), settings
  and the saved bike (DataStore), and the learned Google Maps icon table. Nothing else is: listing includes
  leaves every other file out, so debug log sessions (filesDir/logs), exports (cacheDir, never backed up),
  widget state and shared preferences stay on the phone. Keep this list in step with backup_rules.xml.
  Cloud backup runs only when it is end-to-end encrypted (a screen lock is set).
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="safar.db" />
        <include domain="database" path="safar.db-wal" />
        <include domain="database" path="safar.db-shm" />
        <include domain="database" path="safar.db-journal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/saved_bike.preferences_pb" />
        <include domain="file" path="maps-icons-learned.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="safar.db" />
        <include domain="database" path="safar.db-wal" />
        <include domain="database" path="safar.db-shm" />
        <include domain="database" path="safar.db-journal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="file" path="datastore/saved_bike.preferences_pb" />
        <include domain="file" path="maps-icons-learned.json" />
    </device-transfer>
</data-extraction-rules>
